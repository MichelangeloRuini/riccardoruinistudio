# Server-side only. Configure different values for Preview and Production.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-the-project-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-server-only-service-role-key

# Comma-separated, exact origins. Do not add a trailing slash.
ALLOWED_ORIGINS=https://preview.example.com,https://www.riccardoruinistudio.com

# Generate at least 32 random bytes independently for each environment.
RATE_LIMIT_SECRET=replace-with-a-long-random-secret

# Keep false until SQL, Auth, privacy notice, retention and end-to-end tests are complete.
PROJECT_INQUIRIES_ENABLED=false
